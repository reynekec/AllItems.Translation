<ui:FluentWindow x:Class="AllItems.Translation.App.Views.StudySessionWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:study="clr-namespace:AllItems.Translation.Core.Study;assembly=AllItems.Translation.Core"
                 Title="Study"
                 Height="680" Width="760"
                 MinHeight="560" MinWidth="680"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica">
    <ui:FluentWindow.InputBindings>
        <!-- Space / Enter reveal the answer; 0-5 grade the current card. CanExecute guards keep these inert outside an active card. -->
        <KeyBinding Key="Space" Command="{Binding ShowAnswerCommand}" />
        <KeyBinding Key="Enter" Command="{Binding ShowAnswerCommand}" />
        <KeyBinding Key="D0" Command="{Binding GradeCommand}" CommandParameter="{x:Static study:ReviewGrade.Blackout}" />
        <KeyBinding Key="NumPad0" Command="{Binding GradeCommand}" CommandParameter="{x:Static study:ReviewGrade.Blackout}" />
        <KeyBinding Key="D1" Command="{Binding GradeCommand}" CommandParameter="{x:Static study:ReviewGrade.Incorrect}" />
        <KeyBinding Key="NumPad1" Command="{Binding GradeCommand}" CommandParameter="{x:Static study:ReviewGrade.Incorrect}" />
        <KeyBinding Key="D2" Command="{Binding GradeCommand}" CommandParameter="{x:Static study:ReviewGrade.Familiar}" />
        <KeyBinding Key="NumPad2" Command="{Binding GradeCommand}" CommandParameter="{x:Static study:ReviewGrade.Familiar}" />
        <KeyBinding Key="D3" Command="{Binding GradeCommand}" CommandParameter="{x:Static study:ReviewGrade.Hard}" />
        <KeyBinding Key="NumPad3" Command="{Binding GradeCommand}" CommandParameter="{x:Static study:ReviewGrade.Hard}" />
        <KeyBinding Key="D4" Command="{Binding GradeCommand}" CommandParameter="{x:Static study:ReviewGrade.Good}" />
        <KeyBinding Key="NumPad4" Command="{Binding GradeCommand}" CommandParameter="{x:Static study:ReviewGrade.Good}" />
        <KeyBinding Key="D5" Command="{Binding GradeCommand}" CommandParameter="{x:Static study:ReviewGrade.Easy}" />
        <KeyBinding Key="NumPad5" Command="{Binding GradeCommand}" CommandParameter="{x:Static study:ReviewGrade.Easy}" />
    </ui:FluentWindow.InputBindings>
    <ui:FluentWindow.Resources>
        <ItemsPanelTemplate x:Key="SentenceWordsPanel">
            <WrapPanel HorizontalAlignment="Center" />
        </ItemsPanelTemplate>
        <DataTemplate x:Key="SentenceWordTemplate">
            <TextBlock Text="{Binding Text}" FontSize="16" Opacity="0.85" Margin="0,0,6,0" ToolTip="{Binding Reason}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="Opacity" Value="1" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </DataTemplate>
    </ui:FluentWindow.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Height="32" MinHeight="32" Title="Study">
            <ui:TitleBar.TrailingContent>
                <StackPanel Orientation="Horizontal" Margin="0,0,8,0" VerticalAlignment="Center">
                    <ui:Button Width="46" Height="32" Appearance="Transparent" ToolTip="Study cards you've missed before" Margin="0,0,8,0"
                               Icon="{ui:SymbolIcon ArrowUndo24}" 
                               Command="{Binding StartRetrainCurrentSessionCommand}" />
                    <ui:Button Width="46" Height="32" Appearance="Transparent" ToolTip="Study trouble cards missed at least 3 times" 
                               Icon="{ui:SymbolIcon Warning24}"
                               Command="{Binding StartLeechSessionCommand}" />
                </StackPanel>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <Grid Grid.Row="1" Margin="0,16,0,0">

            <!-- Setup panel -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding IsSetupVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel MaxWidth="560">
                    <TextBlock Text="Languages" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Margin="0,6,0,0" Opacity="0.72" TextWrapping="Wrap"
                               Text="Choose the direction you want to review before starting a study mode." />

                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="I know" Margin="0,0,0,6" />
                            <ComboBox ItemsSource="{Binding AvailableLanguages}"
                                      SelectedItem="{Binding SourceLanguage}"
                                      HorizontalAlignment="Stretch" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Quiz me on" Margin="0,0,0,6" />
                            <ComboBox ItemsSource="{Binding AvailableLanguages}"
                                      SelectedItem="{Binding TargetLanguage}"
                                      HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Grid>

                    <Border Margin="0,18,0,0"
                            Padding="14"
                            CornerRadius="8"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                        <StackPanel>
                            <TextBlock Text="Current summary" FontWeight="SemiBold" />
                            <WrapPanel Margin="0,10,0,0">
                                <Border Margin="0,0,10,8"
                                        Padding="10,6"
                                        CornerRadius="999"
                                        Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                    <TextBlock Opacity="0.82" Text="{Binding AvailableWordsText}" />
                                </Border>
                                <Border Margin="0,0,10,8"
                                        Padding="10,6"
                                        CornerRadius="999"
                                        Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                    <TextBlock Opacity="0.82" Text="{Binding RetrainMissedAvailabilityText}" />
                                </Border>
                                <Border Margin="0,0,0,8"
                                        Padding="10,6"
                                        CornerRadius="999"
                                        Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                    <TextBlock Opacity="0.82" Text="{Binding RetrainTroubleAvailabilityText}" />
                                </Border>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Margin="0,24,0,0" Text="Study mode" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Margin="0,6,0,0" Opacity="0.72" TextWrapping="Wrap"
                               Text="Pick how you want to review this language pair right now." />

                    <ui:CardAction Margin="0,18,0,10"
                                   Command="{Binding StartSessionCommand}"
                                   Background="{DynamicResource AccentFillColorDefaultBrush}"
                                   Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                   BorderBrush="{DynamicResource AccentFillColorSecondaryBrush}"
                                   BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Start session" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                            <TextBlock Margin="0,4,0,0" Opacity="0.85" TextWrapping="Wrap" Foreground="{DynamicResource TextOnAccentFillColorSecondaryBrush}"
                                       Text="Standard spaced-repetition review using due cards first, then new cards from this language pair." />
                        </StackPanel>
                    </ui:CardAction>

                    <Border Margin="0,18,0,0"
                            Padding="14"
                            CornerRadius="8"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            Visibility="{Binding StatusMessage, Converter={StaticResource NullOrEmptyToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="Session info" FontWeight="SemiBold" />
                            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Opacity="0.8"
                                       Text="{Binding StatusMessage}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Session complete panel -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding IsSessionComplete, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="Session complete!" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center">
                    <Run Text="Reviewed " /><Run Text="{Binding ReviewedCount, Mode=OneWay}" /><Run Text=" card(s)." />
                </TextBlock>
                <ui:Button Content="Study Again" Appearance="Primary" Margin="0,20,0,0" HorizontalAlignment="Center"
                           Command="{Binding RestartCommand}" />
            </StackPanel>

            <!-- Active card panel -->
            <Grid Visibility="{Binding IsSessionActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{Binding ProgressText}" Opacity="0.6" HorizontalAlignment="Center" />

                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding FrontText}" FontSize="32" FontWeight="SemiBold" HorizontalAlignment="Center" TextWrapping="Wrap" />

                    <!-- Source-language sentence on the front: it's in the prompt's language, so it never leaks the answer. -->
                    <ItemsControl Margin="0,16,0,0" ItemsSource="{Binding SentenceWords}"
                                  ItemsPanel="{StaticResource SentenceWordsPanel}"
                                  ItemTemplate="{StaticResource SentenceWordTemplate}"
                                  Visibility="{Binding ExampleSentence, Converter={StaticResource NullOrEmptyToVisibilityConverter}}" />

                    <!-- Answer and its destination-language sentence stay hidden until the card is flipped. -->
                    <StackPanel Visibility="{Binding IsAnswerShown, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Margin="0,20,0,0" FontSize="26" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                   HorizontalAlignment="Center" TextWrapping="Wrap"
                                   Text="{Binding BackText}" />

                        <ItemsControl Margin="0,16,0,0" ItemsSource="{Binding BackSentenceWords}"
                                      ItemsPanel="{StaticResource SentenceWordsPanel}"
                                      ItemTemplate="{StaticResource SentenceWordTemplate}"
                                      Visibility="{Binding BackExampleSentence, Converter={StaticResource NullOrEmptyToVisibilityConverter}}" />
                    </StackPanel>
                </StackPanel>

                <Grid Grid.Row="2" Margin="0,20,0,0">
                    <ui:Button Content="Show Answer" Appearance="Primary" HorizontalAlignment="Center"
                               ToolTip="Show answer (Space / Enter)"
                               Command="{Binding ShowAnswerCommand}"
                               Visibility="{Binding IsAnswerShown, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                Visibility="{Binding IsAnswerShown, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ui:Button Content="0" Width="52" Margin="0,0,6,0" HorizontalContentAlignment="Center"
                                   ToolTip="Blackout — no recollection at all"
                                   Background="#B01818" Foreground="White" BorderBrush="#B01818"
                                   Command="{Binding GradeCommand}" CommandParameter="{x:Static study:ReviewGrade.Blackout}" />
                        <ui:Button Content="1" Width="52" Margin="0,0,6,0" HorizontalContentAlignment="Center"
                                   ToolTip="Incorrect — but it felt familiar once revealed"
                                   Background="#D13438" Foreground="White" BorderBrush="#D13438"
                                   Command="{Binding GradeCommand}" CommandParameter="{x:Static study:ReviewGrade.Incorrect}" />
                        <ui:Button Content="2" Width="52" Margin="0,0,6,0" HorizontalContentAlignment="Center"
                                   ToolTip="Incorrect — but the answer seemed easy to recall"
                                   Background="#E8730C" Foreground="White" BorderBrush="#E8730C"
                                   Command="{Binding GradeCommand}" CommandParameter="{x:Static study:ReviewGrade.Familiar}" />
                        <ui:Button Content="3" Width="52" Margin="0,0,6,0" HorizontalContentAlignment="Center"
                                   ToolTip="Correct — but recalled with serious difficulty"
                                   Background="#C79A00" Foreground="White" BorderBrush="#C79A00"
                                   Command="{Binding GradeCommand}" CommandParameter="{x:Static study:ReviewGrade.Hard}" />
                        <ui:Button Content="4" Width="52" Margin="0,0,6,0" HorizontalContentAlignment="Center"
                                   ToolTip="Correct — after some hesitation"
                                   Background="#5B9A1E" Foreground="White" BorderBrush="#5B9A1E"
                                   Command="{Binding GradeCommand}" CommandParameter="{x:Static study:ReviewGrade.Good}" />
                        <ui:Button Content="5" Width="52" HorizontalContentAlignment="Center"
                                   ToolTip="Perfect — effortless recall"
                                   Background="#107C10" Foreground="White" BorderBrush="#107C10"
                                   Command="{Binding GradeCommand}" CommandParameter="{x:Static study:ReviewGrade.Easy}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
